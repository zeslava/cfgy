# Конфигурация cfgy-server (переменные окружения)
# Файл: /usr/local/etc/cfgy_server/cfgy_server.conf
# Права: 0640, владелец root:cfgy

# База данных
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cfgy

# Статика Web UI встроена в бинарь. Чтобы раздавать её с диска — путь к каталогу с index.html:
# CFGY_WEB_ROOT=/var/lib/cfgy_server/web/build

# Криптография: cfgy generate-secrets --format env
# CFGY_MASTER_KEY обязателен — без него сервер не запустится.
# CFGY_JWT_SECRET без значения генерируется при старте (сессии сбрасываются после перезапуска).
# CFGY_MASTER_KEY=
# CFGY_JWT_SECRET=

# Сервер (0.0.0.0 для доступа снаружи)
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8080

# Логирование
RUST_LOG=info

# OIDC SSO (вход через внешний IdP в веб-интерфейсе). Опционально. ZID_* принимаются как fallback.
# Issuer IdP. Альтернатива: OIDC_BASE_URL
# OIDC_ISSUER=https://idp.example.com
# client_id и client_secret из настроек приложения в IdP
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Callback URL. Должен побайтово совпадать с redirect_uris в IdP.
# OIDC_REDIRECT_URI=https://your-server.example.com/auth/oidc/callback
