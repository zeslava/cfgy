# Конфигурация cfgy-server (переменные окружения)
# Файл: /usr/local/etc/cfgy_server/cfgy_server.conf
# Права: 0640, владелец root:cfgy

# База данных
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cfgy

# Статика Web UI (опционально). По умолчанию сервис ищет web/dist в рабочей директории
# (/var/lib/cfgy_server). Если статику положили в другое место — задайте путь к каталогу с index.html:
# CFGY_WEB_ROOT=/var/lib/cfgy_server/web/dist

# Криптография (обязательно задать в проде!)
CFGY_MASTER_KEY=your-master-key-minimum-32-characters-long
CFGY_JWT_SECRET=your-jwt-secret-minimum-16-chars

# Сервер (0.0.0.0 для доступа снаружи)
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8080

# Логирование
RUST_LOG=info

# ZID OAuth 2.0 (вход через ZID в веб-интерфейсе). Опционально.
# Базовый URL ZID (issuer). Альтернатива: ZID_BASE_URL
# ZID_ISSUER=https://zid.example.com
# client_id и client_secret из настроек приложения в ZID
# ZID_CLIENT_ID=
# ZID_CLIENT_SECRET=
# Callback URL. Должен побайтово совпадать с redirect_uris в ZID.
# ZID_REDIRECT_URI=https://your-server.example.com/oauth/zid/callback
