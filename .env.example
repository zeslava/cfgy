# Конфигурация переменных окружения для CFGY
# Скопируйте в .env и настройте: cp .env.example .env

# ============================================
# База данных
# ============================================
# URL PostgreSQL. Локально с Docker (task up): порт 5433 с хоста, внутри контейнера 5432
DATABASE_URL=postgres://postgres:postgres@localhost:5433/cfgy

# Максимум подключений к БД (по умолчанию: 20)
# DATABASE_MAX_CONNECTIONS=20

# ============================================
# Криптография и безопасность
# ============================================
# Ключ шифрования параметров, минимум 32 символа. В проде — обязательно свой!
# Генерация: cfgy generate-secrets  или  openssl rand -hex 32
CFGY_MASTER_KEY=your-master-key-minimum-32-characters-long

# Секрет для JWT сессий, минимум 16 символов. В проде — обязательно свой!
# Генерация: cfgy generate-secrets  или  openssl rand -hex 16
CFGY_JWT_SECRET=your-jwt-secret-minimum-16-chars

# ============================================
# Сервер
# ============================================
# Хост (по умолчанию: 127.0.0.1). Для доступа снаружи: 0.0.0.0
# SERVER_HOST=127.0.0.1
# Порт (по умолчанию: 8080)
# SERVER_PORT=8080

# ============================================
# CORS
# ============================================
# Разрешённые источники через запятую. Пусто — разрешаются все (удобно локально)
# В проде задайте явно, например: https://app.example.com
# ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ============================================
# HTTPS
# ============================================
# Включить HSTS и связанные заголовки (только при работе по HTTPS)
# ENABLE_HTTPS=true

# ============================================
# Логирование
# ============================================
# Уровень: trace, debug, info, warn, error (по умолчанию: info)
RUST_LOG=info

# Формат: json — для парсинга в проде; пусто — человекочитаемый
# LOG_FORMAT=json

# ============================================
# ZID OAuth 2.0 (вход через ZID)
# ============================================
# Базовый URL ZID (issuer). Альтернатива: ZID_BASE_URL
# ZID_ISSUER=https://zid.example.com

# client_id и client_secret из настроек приложения в ZID
# ZID_CLIENT_ID=
# ZID_CLIENT_SECRET=

# Callback URL фронта. Должен побайтово совпадать с redirect_uris в ZID.
# Поддерживаются пути /auth/zid/callback и /oauth/zid/callback. Альтернатива: ZID_CALLBACK_URL
# ZID_REDIRECT_URI=https://app.example.com/auth/zid/callback

# ============================================
# CLI (подключение к серверу)
# ============================================
# URL сервера и API-токен (токен создаётся в веб-дашборде)
# CFGY_SERVER_URL=http://localhost:8080
# CFGY_API_TOKEN=
