# Конфигурация переменных окружения для CFGY
# Скопируйте в .env и настройте: cp .env.example .env

# ============================================
# База данных
# ============================================
# URL PostgreSQL. Локально с Docker (task up): порт 5433 с хоста, внутри контейнера 5432
DATABASE_URL=postgres://postgres:postgres@localhost:5433/cfgy

# Максимум подключений к БД (по умолчанию: 20)
# DATABASE_MAX_CONNECTIONS=20

# ============================================
# Криптография и безопасность
# ============================================
# Ключ шифрования параметров, минимум 32 символа. В проде — обязательно свой!
# Генерация: cfgy generate-secrets  или  openssl rand -hex 32
CFGY_MASTER_KEY=your-master-key-minimum-32-characters-long

# Секрет для JWT сессий, минимум 16 символов. В проде — обязательно свой!
# Генерация: cfgy generate-secrets  или  openssl rand -hex 16
CFGY_JWT_SECRET=your-jwt-secret-minimum-16-chars

# ============================================
# Сервер
# ============================================
# Хост (по умолчанию: 127.0.0.1). Для доступа снаружи: 0.0.0.0
# SERVER_HOST=127.0.0.1
# Порт (по умолчанию: 8080)
# SERVER_PORT=8080

# ============================================
# CORS
# ============================================
# Разрешённые источники через запятую. Пусто — разрешаются все (удобно локально)
# В проде задайте явно, например: https://app.example.com
# ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ============================================
# Веб-интерфейс и HTTPS
# ============================================
# Каталог с собранным фронтом (index.html, assets). Для системного сервиса (FreeBSD): /var/lib/cfgy_server/web/dist
# CFGY_WEB_ROOT=

# Включить HSTS (заголовок Strict-Transport-Security). Задайте true или 1 при работе через HTTPS.
# ENABLE_HTTPS=false

# ============================================
# Логирование
# ============================================
# Уровень: trace, debug, info, warn, error (по умолчанию: info)
RUST_LOG=info

# Формат: json — для парсинга в проде; пусто — человекочитаемый
# LOG_FORMAT=json

# ============================================
# OIDC OAuth 2.0 (вход через внешний провайдер: ZID, Keycloak, Auth0, Authentik и др.)
# ============================================
# Базовый URL провайдера (issuer). Должен быть доступен с клиента пользователя.
# OIDC_ISSUER=https://sso.example.com
# ZID_ISSUER=   (устаревший вариант, работает как fallback)

# URL провайдера для запросов с бэкенда. Если не задан — используется OIDC_ISSUER.
# OIDC_BASE_URL=
# ZID_BASE_URL=   (fallback)

# client_id и client_secret из настроек приложения в провайдере
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# ZID_CLIENT_ID= / ZID_CLIENT_SECRET=   (fallback)

# Callback URL фронта. Должен побайтово совпадать с redirect_uris в провайдере.
# Поддерживаются пути /auth/oidc/callback, /oauth/oidc/callback,
#                     /auth/zid/callback, /oauth/zid/callback (алиасы)
# OIDC_REDIRECT_URI=https://app.example.com/auth/oidc/callback
# ZID_REDIRECT_URI=   (fallback)

# Идентификатор провайдера в таблице external_identities (default: "oidc").
# ⚠ Если мигрируете с предыдущей версии (ZID) — задайте "zid",
#   чтобы существующие пользователи сохранили привязку.
# OIDC_PROVIDER_NAME=oidc

# URL для редиректа после успешного входа.
# Нужен ТОЛЬКО если OIDC_REDIRECT_URI ведёт на бэкенд (8080), а SPA на другом порту.
# CFGY_FRONTEND_URL=

# Не проверять TLS при запросах к провайдеру. Только для dev (self-signed). В проде не использовать.
# OIDC_TLS_INSECURE=false
# ZID_TLS_INSECURE=   (fallback)

# Путь к PEM-файлу с доверенным CA. Предпочтительнее OIDC_TLS_INSECURE.
# OIDC_CA_FILE=
# ZID_CA_FILE=   (fallback)

# ============================================
# CLI (подключение к серверу)
# ============================================
# URL сервера и API-токен (токен создаётся в веб-дашборде).
# Те же параметры можно задать в ~/.cfgy/config.yaml (server_url, token); env переопределяет файл.
# CFGY_SERVER_URL=http://localhost:8080
# CFGY_TOKEN=
